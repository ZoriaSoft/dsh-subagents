{
  "name": "dsh-subagents",
  "version": "0.10.1",
  "description": "ZCode-style custom subagents for DeepSeek Harness: roles defined as Markdown files become per-role agent tools the primary model delegates to — on a pinned dsh model route or through an external CLI (agy, vibe, devin). Includes bin/dsh-roles.mjs to run any CLI-backed role headlessly from other harnesses.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZoriaSoft/dsh-subagents.git"
  },
  "homepage": "https://github.com/ZoriaSoft/dsh-subagents#readme",
  "bugs": {
    "url": "https://github.com/ZoriaSoft/dsh-subagents/issues"
  },
  "author": "Zoriasoft",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-roles": "bin/dsh-roles.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./definitions": "./lib/definitions.js",
    "./runner": "./lib/runner.js",
    "./skills": "./lib/skills.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "bin",
    "lib",
    "examples",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts"
  ],
  "scripts": {
    "test": "node --test",
    "smoke": "bash scripts/smoke.sh"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "subagents",
    "agents",
    "orchestration",
    "cordis-plugin"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "compatibility": {
      "node": ">=20",
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.1.5-rc.3": "unknown",
        "0.1.6-alpha.1": "unknown",
        "0.1.6-alpha.2": "unknown",
        "0.1.7-alpha.1": "unknown",
        "0.1.7-alpha.2": "unknown",
        "0.1.7-rc.1": "unknown",
        "0.1.7-rc.2": "unknown"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "engines": {
    "node": ">=20"
  }
}
